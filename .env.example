# ════════════════════════════════════════════════════════════════
# SkillIn environment
#
# The Firebase Web config is REQUIRED: the product has no demo mode and
# no anonymous state, so a user signs in and their profile, roadmap,
# progress and streak live in Firestore under their own uid.
#
# Everything below it is optional. Without any of it the app still runs
# end to end: PDF extraction, skill vectors, gap analysis, recommendations,
# prerequisites and roadmaps are deterministic and run on your own server.
# ════════════════════════════════════════════════════════════════

# ─── Firebase Web config (auth + Firestore), REQUIRED ───
# Not secrets: the browser receives all of them, and Security Rules do
# the enforcing. Still never committed. There is no fallback in the code,
# so the app will tell you plainly if these are missing.
# Firebase console → Project settings → General → Your apps
# Restrict the API key by HTTP referrer in Google Cloud Console.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin (server-authoritative streak & progress) ───
# The full service-account JSON on ONE line.
# Firebase console → Project settings → Service accounts → Generate new private key
# Without this the streak is still COMPUTED server-side from a server
# clock, but cannot be made tamper-proof via Security Rules.
FIREBASE_SERVICE_ACCOUNT_KEY=

# ─── Gemini (optional profile-extraction enrichment) ───
# Free tier: https://aistudio.google.com/app/apikey
# Absent → the deterministic LinkedIn parser is used alone.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── YouTube Data API (optional live resource discovery) ───
# Absent → the curated catalog is used alone.
YOUTUBE_API_KEY=

# ─── Canonical site URL (SEO metadata, OpenGraph, canonical link) ───
NEXT_PUBLIC_SITE_URL=
